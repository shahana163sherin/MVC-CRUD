@model MVC_PRODUCT.Models.Product

<h2>Create Product</h2>
<form asp-action="Create" method="post">
    <div>
        <label asp-for="ProductName"> </label><br />
        <input asp-for="ProductName" />
        <span asp-validation-for="ProductName" style="color:red;"></span>
    </div>

    <div>
        <label asp-for="Price"> </label><br />
        <input asp-for="Price" />
        <span asp-validation-for="Price" style="color:red;"></span>
    </div>

    <br />
    <button type="submit">Create</button>
</form>

